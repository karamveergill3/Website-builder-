# ---- Server ----
PORT=3000
# Loopback only by default. This process holds a Gmail refresh token and has
# no login of its own, so only change HOST if you know why.
# HOST=127.0.0.1

# Where the SQLite file lives, relative to the project root.
DB_PATH=data/prospect-book.db

# ---- Companies House ----
# This is the important one: it is what finds companies you may lawfully email,
# and what the daily hunt runs on.
# Free key from https://developer.company-information.service.gov.uk
# Choose a LIVE application, not sandbox. See docs/COMPANIES-HOUSE.md.
# This is what lets the tool find companies you may lawfully email.
COMPANIES_HOUSE_API_KEY=

# ---- Google Places API (New) ----
# A Google Cloud API key restricted to "Places API (New)", with billing on.
# Used to check whether a company has a website. See docs/PHASE2-PLACES.md.
GOOGLE_MAPS_API_KEY=

# ---- Gmail ----
# OAuth2 client credentials from Google Cloud Console.
# Read docs/PHASE3-GMAIL.md before connecting an account you care about.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Only if you run on a port other than 3000.
# GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ---- Business identity ----
# Optional. Any of these that are set are copied into Settings on first
# boot — but only for fields you have not already filled in through the UI,
# so a manual edit always wins. .env is gitignored, so nothing personal
# ends up in the repo.
# BIZ_TRADING_NAME=Keylo Studios
# BIZ_CONTACT_NAME=Karam Gill
# BIZ_ADDRESS=Dunston Business Village, ST18 9AB
# BIZ_EMAIL=karam@example.com
# BIZ_PHONE=07000 000000
# BIZ_WEBSITE=https://example.com
# BIZ_COMPANY_NUMBER=
# BIZ_VAT_NUMBER=
# BIZ_PLACE_OF_REGISTRATION=England and Wales
