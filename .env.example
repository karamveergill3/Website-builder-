# ---- Server ----
PORT=3000
# Loopback only by default. This process holds a Gmail refresh token and has
# no login of its own, so only change HOST if you know why.
# HOST=127.0.0.1

# Where the SQLite file lives, relative to the project root.
DB_PATH=data/prospect-book.db

# ---- Companies House ----
# This is the important one: it is what finds companies you may lawfully email,
# and what the daily hunt runs on.
# Free key from https://developer.company-information.service.gov.uk
# Choose a LIVE application, not sandbox. See docs/COMPANIES-HOUSE.md.
# This is what lets the tool find companies you may lawfully email.
COMPANIES_HOUSE_API_KEY=

# ---- Google Places API (New) ----
# A Google Cloud API key restricted to "Places API (New)", with billing on.
# Used to check whether a company has a website. See docs/PHASE2-PLACES.md.
GOOGLE_MAPS_API_KEY=

# ---- Gmail ----
# OAuth2 client credentials from Google Cloud Console.
# Read docs/PHASE3-GMAIL.md before connecting an account you care about.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Only if you run on a port other than 3000.
# GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ---- Business identity ----
# Optional. Any of these that are set are copied into Settings on first
# boot — but only for fields you have not already filled in through the UI,
# so a manual edit always wins. .env is gitignored, so nothing personal
# ends up in the repo.
# BIZ_TRADING_NAME=Your Studio Name
# BIZ_CONTACT_NAME=Your Name
# BIZ_ADDRESS=1 Example Street, Town, AB1 2CD
# BIZ_EMAIL=you@example.com
# BIZ_PHONE=07000 000000
# BIZ_WEBSITE=https://example.com
# BIZ_COMPANY_NUMBER=
# BIZ_VAT_NUMBER=
# BIZ_PLACE_OF_REGISTRATION=England and Wales

# ---- Local model (optional) ----
# Reply reading uses a model running on THIS machine, via Ollama. It is
# optional: the rules-based extractor handles numbered replies on its own.
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull llama3.2
# The host must be loopback — a remote address is refused, which is what
# keeps this off any billed AI account. See docs/MOCKUPS.md.
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ---- PayPal (optional — automated "Pay now" on invoices) ----
# REST app credentials from https://developer.paypal.com/dashboard/ (Apps &
# Credentials). With these set, an invoice shows a live Pay now button that
# takes the payment (full or PayPal Pay in 3) and marks the invoice paid on
# its own. Without them, invoices still show your PayPal link + bank details.
# Use PAYPAL_ENV=sandbox with sandbox keys to test with fake money first, then
# switch to live keys and PAYPAL_ENV=live. See docs/PAYPAL.md.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# ---- Stripe (optional — card, Klarna & Clearpay on invoices) ----
# One secret key from https://dashboard.stripe.com/apikeys. With it set, an
# invoice shows a live "Pay by card / Klarna / Clearpay" button that takes the
# payment and marks the invoice paid on its own. WHICH methods appear is set in
# the Stripe Dashboard (Settings -> Payment methods), not here — turn Klarna and
# Clearpay on there. Test vs live is decided by the key itself: sk_test_... uses
# test mode (fake cards), sk_live_... takes real money. See docs/STRIPE.md.
# STRIPE_SECRET_KEY=

# ---- GoCardless Direct Debit (optional — auto-collect maintenance plans) ----
# One access token from https://manage.gocardless.com/ (Developers -> Access
# tokens). With it set, a maintenance plan shows a "Set up Direct Debit" button:
# you send the client a link, they authorise once on GoCardless's own page, and
# from then on the monthly amount is collected automatically — no invoice to
# raise, no link to chase. Test vs live is decided by the token itself:
# sandbox_... uses the sandbox (fake bank), live_... collects real money.
# See docs/DIRECT-DEBIT.md.
# GOCARDLESS_ACCESS_TOKEN=
