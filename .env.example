# ---- Server ----
PORT=3000

# Where the SQLite file lives, relative to the project root.
DB_PATH=data/prospect-book.db

# ---- Phase 2: Google Places API (New) ----
# A Google Cloud API key restricted to "Places API (New)".
# See docs/PHASE2-PLACES.md for the setup walkthrough.
GOOGLE_MAPS_API_KEY=

# ---- Phase 3: Gmail ----
# OAuth2 client credentials for a Desktop app, from Google Cloud Console.
# See docs/PHASE3-GMAIL.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
